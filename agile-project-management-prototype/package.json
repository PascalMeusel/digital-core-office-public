{
  "name": "agile-project-management-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:server:dev\" \"npm:web:dev\"",
    "web:dev": "vite --host 0.0.0.0 --port 5175",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "start": "tsx server/index.ts",
    "userbase:import": "tsx scripts/importSharedUserbase.ts"
  },
  "dependencies": {
    "@digital-core-office/suite-ui": "file:../packages/suite-ui",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
