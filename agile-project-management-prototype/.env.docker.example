# Copy this file to .env.docker before running docker compose.

# Public DNS name that points to the Docker host.
# Caddy requests and renews HTTPS certificates when ports 80 and 443 are reachable.
APP_HOST=agile.example.com

CORS_ORIGIN=

# Optional only for a fresh standalone install.
# For the shared Digital Core Office userbase, import users from Time Tracking instead.
AGILE_INITIAL_ADMIN_NAME=
AGILE_INITIAL_ADMIN_EMAIL=
AGILE_INITIAL_ADMIN_PASSWORD=
