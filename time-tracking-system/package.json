{
  "name": "arbeitszeitbuero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:server:dev\" \"npm:web:dev\"",
    "web:dev": "vite --host 0.0.0.0 --port 5173",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:browsers": "playwright test",
    "test:suite": "playwright test -c playwright.suite.config.ts",
    "test:unit": "node --import tsx --test tests/*.unit.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "userbase:export": "tsx scripts/exportSharedUserbase.ts"
  },
  "dependencies": {
    "@digital-core-office/suite-ui": "file:../packages/suite-ui",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "date-holidays": "^3.30.2",
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "node-ical": "^0.26.1",
    "nodemailer": "^10.0.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdav": "^2.3.0",
    "tsx": "^4.22.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
