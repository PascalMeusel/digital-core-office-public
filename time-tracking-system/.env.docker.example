# Copy this file to .env.docker before running docker compose.

# Public DNS name that points to the Docker host.
# Caddy requests and renews HTTPS certificates when ports 80 and 443 are reachable.
APP_HOST=time.example.com
APP_BASE_URL=https://time.example.com

# Required in production. Generate once and keep it secret:
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
REQUIRE_DATA_ENCRYPTION=true

CORS_ORIGIN=
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=30
DOCTOR_NOTE_MAX_BYTES=2097152
ALLOW_PRIVATE_CALDAV_URLS=false

# Required only for the first Docker start with an empty database.
# Use a unique temporary password; the admin must change it on first login.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional SMTP fallback. Admins can also configure SMTP inside settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
