# Single public Digital Core Office origin.
DCO_APP_HOST=office.example.com
DCO_PUBLIC_BASE_URL=https://office.example.com
DCO_TIMEZONE=Europe/Berlin

# The operator of THIS installation. Review local privacy details before publishing.
DCO_OPERATOR_NAME=
DCO_OPERATOR_ADDRESS=
DCO_SUPPORT_EMAIL=
DCO_PRIVACY_EMAIL=
DCO_PRIVACY_DETAILS=

# Enable one to three modules. Keep COMPOSE_PROFILES identical so disabled
# services are not built or started.
DCO_ENABLED_MODULES=time,inventory,agile
COMPOSE_PROFILES=time,inventory,agile

# Generate each secret independently: openssl rand -base64 32
DCO_INTERNAL_AUTH_SECRET=
DIGITAL_OFFICE_SSO_SECRET=
DIGITAL_OFFICE_SSO_COOKIE_NAME=digital_office_sso
DIGITAL_OFFICE_COOKIE_DOMAIN=

# Core bootstrap is used only when no production userbase is imported.
DCO_INITIAL_ADMIN_NAME=
DCO_INITIAL_ADMIN_EMAIL=
DCO_INITIAL_ADMIN_PASSWORD=
DCO_ALLOW_UNSAFE_ADMIN_PASSWORD=false
DCO_DISABLE_LOCAL_WEB_LOGIN=true

# Time Tracking encryption.
TIME_DATA_ENCRYPTION_KEY=
TIME_REQUIRE_DATA_ENCRYPTION=true

# Optional private Inventory reference JSON mounted separately by the operator.
# Leave blank for a clean or synthetic-data installation.
INVENTORY_REFERENCE_DATA_FILE=

# Core password-reset mail.
DCO_SMTP_HOST=
DCO_SMTP_PORT=587
DCO_SMTP_SECURE=false
DCO_SMTP_USER=
DCO_SMTP_PASS=
DCO_SMTP_FROM=

# Public key only. Never copy the private signing key to the server.
DCO_LICENSE_PUBLIC_KEY_FILE=/licenses/license-public.pem

# Optional encrypted automatic backups: start with --profile backup after creating
# a base64 32-byte key file outside both the source data and backup directories.
DCO_BACKUP_KEY_FILE=./secrets/backup.key
DCO_BACKUP_DIRECTORY=./backups
DCO_BACKUP_INTERVAL_HOURS=24
DCO_BACKUP_RETAIN_DAYS=30

# Tag images for each deployment; retain the previous tag for rollback.
DCO_RELEASE_TAG=local
DCO_APP_MEMORY_LIMIT=512m
DCO_APP_CPU_LIMIT=1.0
