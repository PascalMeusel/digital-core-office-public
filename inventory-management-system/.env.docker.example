# Copy this file to .env.docker before running docker compose.

# Public DNS name that points to the Docker host.
# Caddy requests and renews HTTPS certificates when ports 80 and 443 are reachable.
APP_HOST=inventory.example.com

CORS_ORIGIN=

# Optional bootstrap admin for the first Docker start with an empty database.
# If omitted, a default local admin record exists but has no usable password until one is set.
INVENTORY_SYSTEM_ADMIN_NAME=
INVENTORY_SYSTEM_ADMIN_EMAIL=
INVENTORY_SYSTEM_ADMIN_PASSWORD=
INVENTORY_SYSTEM_FORCE_ADMIN_PASSWORD=false
