PORT=4187
INVENTORY_SYSTEM_DATA=server/data/inventory-system.sqlite
# Persistent imported room plans/photos. Defaults to static-media beside the database.
INVENTORY_STATIC_MEDIA_DIR=
INVENTORY_SYSTEM_ADMIN_NAME=
INVENTORY_SYSTEM_ADMIN_EMAIL=
INVENTORY_SYSTEM_ADMIN_PASSWORD=
INVENTORY_SYSTEM_FORCE_ADMIN_PASSWORD=false
CORS_ORIGIN=
# Optional ClickUp integration: 32 random bytes, base64 encoded. Keep stable and back up securely.
# Set only on the server; never expose through a VITE_ variable or commit a real key.
INVENTORY_CLICKUP_TOKEN_KEY=
