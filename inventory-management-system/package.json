{
  "name": "inventory-management-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:server:dev\" \"npm:web:dev\"",
    "web:dev": "vite --host 0.0.0.0 --port 5174",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:unit": "node --import tsx --test tests/*.unit.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "start": "tsx server/index.ts",
    "inventory:bootstrap-admin": "tsx scripts/bootstrapAdmin.ts",
    "inventory:normalize-reference": "tsx scripts/normalizeReferenceInventory.ts",
    "inventory:backup": "tsx scripts/inventoryBackup.ts --backup",
    "inventory:restore": "tsx scripts/inventoryBackup.ts --restore",
    "userbase:import": "tsx scripts/importSharedUserbase.ts"
  },
  "dependencies": {
    "@digital-core-office/suite-ui": "file:../packages/suite-ui",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
